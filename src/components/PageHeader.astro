---
import Navigation from './Navigation.astro';
---

<header>
  <Navigation />
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    background-color: #fff;
    border-bottom: 1px solid #000;
    width: 100%;
    height: 50px;
  }

  header :global(nav) {
    display: flex;
    align-items: center;
    height: 100%;
  }

  header :global(ul) {
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
    border: none;
    margin: 0;
  }

  header :global(li) {
    list-style-type: none;
    padding: 5px 10px;
    border: none;
    text-align: center;
    margin: 0;
  }

  header :global(li:not(:last-child)) {
    border-right: none;
  }

  header :global(li:hover) {
    padding: 5px 10px;
    margin: 0;
  }

  header :global(li a:hover) {
    text-decoration: none;
  }

  header :global(strong) {
    padding: 0 10px;
  }
</style>
