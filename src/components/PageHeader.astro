---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<div class="marquee-container">
  <div class="marquee-text">
    S1MPOSIO ECLÉCTICO. UN SIMPOSIO ES UN COMPENDIO DE ESPECIALISTAS EN EL QUE SE EXPONE Y DESARROLLA UN TEMA DE FORMA COMPLETA Y DETALLADA
  </div>
</div>

<header>
  <nav>
    <strong>
      {isHome ? (
        <a href="https://github.com/simposio-eclectico" target="_blank">open-source artist</a>
      ) : (
        <a href="/">S1MP</a>
      )}
    </strong><br />
    <ul>
      <li><a href="/meme/">meme</a></li>
      <li><a href="/audio/">audio</a></li>
      <li><a href="/experimentos/">experimentos</a></li>
      <li><a href="/acerca/">acerca</a></li>
    </ul>
  </nav>
</header>

<style>
  .marquee-container {
    width: 100%;
    background-color: #fff;
    border-bottom: 1px solid #000;
    overflow: hidden;
    padding: 8px 0;
    font-size: 12px;
    line-height: 1.4;
  }

  .marquee-text {
    display: inline-block;
    padding-left: 100%;
    animation: marquee 30s linear infinite;
    white-space: nowrap;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    background-color: #fff;
    border-bottom: 1px solid #000;
    width: 100%;
    height: 50px;
  }

  nav {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    height: 100%;
    width: 100%;
  }

  strong {
    padding: 0 10px;
  }

  strong a {
    color: #000;
    text-decoration: none;
    line-height: 1.4;
  }

  ul {
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
    border: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  li {
    list-style-type: none;
    margin: 5px 10px;
    padding: 0;
  }

  li a {
    color: #000;
  }

  li a:hover {
    text-decoration: none;
  }
</style>
