---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<footer class="page-footer">
  <nav>
    <strong>
      {isHome ? (
        <a href="https://github.com/simposio-eclectico" target="_blank">open-source artist</a>
      ) : (
        <a href="/">S1MP</a>
      )}
    </strong><br />
    <ul>
      <li><a href="/escritos/">escritos</a></li>
      <li><a href="/meme/">meme</a></li>
      <li><a href="/audio/">audio</a></li>
      <li><a href="/experimentos/">experimentos</a></li>
      <li><a href="/acerca/">acerca</a></li>
    </ul>
  </nav>
</footer>

<style>
  .page-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40px;
    background-color: #fff;
    border-top: 1px solid #000;
    overflow: hidden;
    z-index: 100;
    display: flex;
    align-items: center;
  }

  nav {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  strong {
    padding: 0 10px;
    font-size: 1rem;
    display: flex;
    align-items: center;
  }

  strong a {
    color: #000;
    text-decoration: none;
    line-height: 1;
  }

  ul {
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
    border: none;
    margin: 0;
    padding: 0;
    flex: 1;
    align-items: center;
  }

  li {
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    font-size: 1rem;
  }

  li a {
    color: #000;
    padding: 0 10px;
  }

  li a:hover {
    text-decoration: none;
  }
</style>
