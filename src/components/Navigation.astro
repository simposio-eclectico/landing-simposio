---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<nav>
  <strong>
    {isHome ? (
      <a href="https://github.com/simposio-eclectico" target="_blank">open-source artist</a>
    ) : (
      <a href="/">S1MP</a>
    )}
  </strong><br />
  <ul>
    <li><a href="/meme/">meme</a></li>
    <li><a href="/audio/">audio</a></li>
    <li><a href="/experimentos/">experimentos</a></li>
    <li><a href="/acerca/">acerca</a></li>
  </ul>
</nav>

<style>
  nav {
    width: 100%;
  }

  strong a {
    color: #000;
    text-decoration: none;
    margin: 10px;
    line-height: 1.4;
  }

  ul {
    border-top: 1px solid #000;
  }

  li {
    padding: 10px;
    list-style-type: "\2592";
    text-align: right;
  }

  li:not(:last-child) {
    border-bottom: 1px solid #000;
  }

  li:hover {
    padding: 10px 15px;
    margin: 0 20px;
  }

  li a {
    color: #000;
  }
</style>
