---
// Unicode gradient shading experiment
---

<div class="unicode-gradient-container">
  <div id="gradientDisplay" class="gradient-display"></div>
  <div class="controls">
    <button id="animateBtn">Animar</button>
    <button id="noiseBtn">Ruido</button>
    <button id="waveBtn">Onda</button>
    <button id="resetBtn">Reiniciar</button>
  </div>
</div>

<script>
  const display = document.getElementById('gradientDisplay');
  const COLS = 60;
  const ROWS = 25;

  // Unicode gradient characters (light to dark)
  const GRADIENTS = [' ', '░', '▒', '▓', '█'];

  interface Cell {
    value: number; // 0-1
    targetValue: number;
    vx: number;
    vy: number;
  }

  let grid: Cell[][] = [];
  let animating = false;
  let mode: 'animate' | 'noise' | 'wave' | null = null;
  let time = 0;

  function initializeGrid() {
    grid = [];
    for (let y = 0; y < ROWS; y++) {
      grid[y] = [];
      for (let x = 0; x < COLS; x++) {
        grid[y][x] = {
          value: 0.5,
          targetValue: 0.5,
          vx: (Math.random() - 0.5) * 0.02,
          vy: (Math.random() - 0.5) * 0.02,
        };
      }
    }
  }

  function getCharacter(value: number): string {
    const index = Math.floor(value * (GRADIENTS.length - 1));
    return GRADIENTS[Math.max(0, Math.min(index, GRADIENTS.length - 1))];
  }

  function render() {
    let html = '';
    for (let y = 0; y < ROWS; y++) {
      for (let x = 0; x < COLS; x++) {
        const cell = grid[y][x];

        if (animating) {
          cell.value += (cell.targetValue - cell.value) * 0.1;
        }

        html += getCharacter(cell.value);
      }
      html += '\n';
    }
    display.textContent = html;
  }

  function startAnimation() {
    animating = true;
    mode = 'animate';

    function animate() {
      time++;

      for (let y = 0; y < ROWS; y++) {
        for (let x = 0; x < COLS; x++) {
          const cell = grid[y][x];
          cell.vx += (Math.random() - 0.5) * 0.01;
          cell.vy += (Math.random() - 0.5) * 0.01;
          cell.vx *= 0.98;
          cell.vy *= 0.98;

          cell.targetValue = Math.max(
            0,
            Math.min(1, cell.targetValue + cell.vx + cell.vy)
          );
        }
      }

      render();

      if (time < 300) {
        requestAnimationFrame(animate);
      } else {
        animating = false;
        time = 0;
      }
    }

    animate();
  }

  function generateNoise() {
    for (let y = 0; y < ROWS; y++) {
      for (let x = 0; x < COLS; x++) {
        grid[y][x].value = Math.random();
      }
    }
    render();
  }

  function generateWave() {
    animating = true;
    mode = 'wave';
    time = 0;

    function wave() {
      time++;

      for (let y = 0; y < ROWS; y++) {
        for (let x = 0; x < COLS; x++) {
          const distX = x - COLS / 2;
          const distY = y - ROWS / 2;
          const distance = Math.sqrt(distX * distX + distY * distY);

          const waveValue =
            Math.sin((distance - time * 0.2) * 0.1) * 0.5 + 0.5;
          grid[y][x].value = Math.max(0, Math.min(1, waveValue));
        }
      }

      render();

      if (time < 150) {
        requestAnimationFrame(wave);
      } else {
        animating = false;
        time = 0;
      }
    }

    wave();
  }

  function reset() {
    animating = false;
    time = 0;
    mode = null;
    initializeGrid();
    render();
  }

  // Event listeners
  document.getElementById('animateBtn')?.addEventListener('click', startAnimation);
  document.getElementById('noiseBtn')?.addEventListener('click', generateNoise);
  document.getElementById('waveBtn')?.addEventListener('click', generateWave);
  document.getElementById('resetBtn')?.addEventListener('click', reset);

  // Mouse interaction
  document.addEventListener('mousemove', (e) => {
    const rect = display.getBoundingClientRect();
    const mouseX = e.clientX - rect.left;
    const mouseY = e.clientY - rect.top;

    const charWidth = rect.width / COLS;
    const charHeight = rect.height / ROWS;

    const gridX = Math.floor(mouseX / charWidth);
    const gridY = Math.floor(mouseY / charHeight);

    const radius = 8;

    for (let y = 0; y < ROWS; y++) {
      for (let x = 0; x < COLS; x++) {
        const dx = x - gridX;
        const dy = y - gridY;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < radius) {
          const influence = 1 - distance / radius;
          grid[y][x].value = Math.max(
            0,
            Math.min(1, grid[y][x].value + influence * 0.1)
          );
        }
      }
    }

    render();
  });

  // Initialize
  initializeGrid();
  render();
</script>

<style>
  .unicode-gradient-container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #fff;
  }

  .gradient-display {
    flex: 1;
    padding: 20px;
    font-family: 'Fira Code', monospace;
    font-size: 1rem;
    line-height: 1.2;
    white-space: pre;
    overflow: hidden;
    user-select: none;
    cursor: crosshair;
  }

  .controls {
    display: flex;
    gap: 10px;
    padding: 20px;
    background-color: #fff;
    border-top: 1px solid #000;
    justify-content: center;
  }

  button {
    padding: 10px 20px;
    background-color: #fff;
    border: 1px solid #000;
    cursor: pointer;
    font-family: 'Fira Code', monospace;
    font-size: 1rem;
    transition: all 0.2s;
  }

  button:hover {
    background-color: #000;
    color: #fff;
  }

  button:active {
    transform: scale(0.95);
  }
</style>
