---
import Layout from '../layouts/Layout.astro';
import AnimatedLogo from '../components/AnimatedLogo.astro';
import PageHeaderTop from '../components/PageHeaderTop.astro';
---

<Layout title="simposio+eclectico">
  <PageHeaderTop />
  <AnimatedLogo />
  <main>
    <nav>
      <strong>
        <a href="https://github.com/simposio-eclectico" target="_blank">open-source artist</a>
      </strong>
      <ul>
        <li><a href="/escritos/">escritos</a></li>
        <li><a href="/meme/">meme</a></li>
        <li><a href="/audio/">audio</a></li>
        <li><a href="/experimentos/">experimentos</a></li>
        <li><a href="/acerca/">acerca</a></li>
      </ul>
    </nav>
  </main>
</Layout>

<style>
  nav {
    width: 100%;
  }

  strong a {
    color: #000;
    text-decoration: none;
    margin: 10px;
    line-height: 1.4;
  }

  ul {
    border-top: 1px solid #000;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    padding: 10px;
    list-style-type: "\2592";
    text-align: right;
  }

  li:not(:last-child) {
    border-bottom: 1px solid #000;
  }

  li:hover {
    padding: 10px 15px;
    margin: 0 20px;
  }

  li a {
    color: #000;
  }

  @media screen and (min-width: 600px) {
    nav {
      position: fixed;
      bottom: 0;
      right: 0;
      text-align: right;
    }

    ul {
      display: inline-flex;
      border: none;
    }

    li {
      margin: 0 25px;
      padding: 0;
      list-style-type: "\2592";
      text-align: right;
      border: none;
    }

    li:not(:last-child) {
      border: none;
    }

    li:hover {
      padding: 0;
      margin: 0 25px;
      text-decoration: underline;
    }

    strong a {
      margin: 0;
    }
  }
</style>
