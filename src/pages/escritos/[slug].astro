---
import Layout from '../../layouts/Layout.astro';
import PageHeaderTop from '../../components/PageHeaderTop.astro';
import PageFooter from '../../components/PageFooter.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const escritos = await getCollection('escritos');
  return escritos.map((escrito) => ({
    params: { slug: escrito.slug },
    props: { escrito },
  }));
}

const { escrito } = Astro.props;
const { Content } = await escrito.render();
---

<Layout title={`simposio+eclectico+${escrito.slug}`}>
  <PageHeaderTop />
  <main>
    <article class="escrito-articulo">
      <header class="escrito-header">
        <a href="/escritos/" class="back-link">← volver</a>
        <h1>{escrito.data.title}</h1>
        {escrito.data.description && (
          <p class="subtitle">{escrito.data.description}</p>
        )}
        <p class="meta">
          <span class="date">
            {new Date(escrito.data.pubDate).toLocaleDateString('es-ES', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </span>
          <span class="author">{escrito.data.author}</span>
        </p>
      </header>

      <div class="escrito-content">
        <Content />
      </div>
    </article>
  </main>
  <PageFooter />
</Layout>

<style>
  main {
    padding: 20px;
    max-width: 800px;
    margin: 0 auto;
  }

  .back-link {
    color: #000;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .escrito-header {
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid #000;
  }

  h1 {
    font-size: 2rem;
    margin: 20px 0 10px 0;
  }

  .subtitle {
    font-size: 1.1rem;
    color: #666;
    margin: 10px 0;
  }

  .meta {
    display: flex;
    gap: 20px;
    font-size: 0.9rem;
    color: #999;
    margin-top: 15px;
  }

  .escrito-content {
    line-height: 1.8;
    font-size: 1rem;
  }

  :global(.escrito-content h2) {
    font-size: 1.5rem;
    margin-top: 30px;
    margin-bottom: 15px;
  }

  :global(.escrito-content h3) {
    font-size: 1.2rem;
    margin-top: 25px;
    margin-bottom: 10px;
  }

  :global(.escrito-content p) {
    margin-bottom: 15px;
  }

  :global(.escrito-content ul),
  :global(.escrito-content ol) {
    margin-left: 20px;
    margin-bottom: 15px;
  }

  :global(.escrito-content li) {
    margin-bottom: 8px;
  }

  :global(.escrito-content blockquote) {
    border-left: 4px solid #000;
    margin: 20px 0;
    padding-left: 20px;
    font-style: italic;
    color: #666;
  }

  :global(.escrito-content code) {
    background-color: #f5f5f5;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.9em;
  }

  :global(.escrito-content pre) {
    background-color: #f5f5f5;
    padding: 15px;
    border-radius: 5px;
    overflow-x: auto;
    margin-bottom: 15px;
  }

  :global(.escrito-content pre code) {
    background-color: transparent;
    padding: 0;
  }
</style>
