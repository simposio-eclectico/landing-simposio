---
import '../styles/global.css';
import '../styles/pages.css';

interface Props {
  title: string;
  pageStyles?: string[];
}

const { title, pageStyles = [] } = Astro.props;

// Dynamically import page-specific styles
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;500&display=swap"
      rel="stylesheet"
    />
    {pageStyles.map((style) => <link rel="stylesheet" href={style} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
